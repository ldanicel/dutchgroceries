{
  "name": "dutchgroceries",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",
  "postCreateCommand": "pip install --user -r requirements.lock -e '.[dev]'",
  "containerEnv": {
    "GROCERIES_DATA_DIR": "${containerWorkspaceFolder}/demo",
    "GROCERIES_SECRETS_DIR": "${containerWorkspaceFolder}/demo/secrets",
    "GROCERIES_HOST": "0.0.0.0",
    "GROCERIES_PORT": "8080"
  },
  "forwardPorts": [
    8080
  ],
  "portsAttributes": {
    "8080": {
      "label": "dashboard"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarshall.ruff"
      ],
      "settings": {
        "python.testing.pytestEnabled": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarshall.ruff"
        }
      }
    }
  }
}
