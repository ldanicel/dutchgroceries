# dutchgroceries configuration.
#
# Copy to .env (Docker compose) or to any file and point GROCERIES_ENV_FILE at it (venv/systemd).
# Every setting is optional and commented out: the value shown is the default. Uncomment only what you
# change. Variables already set in the environment win over this file.

# --- Storage ---------------------------------------------------------------------------------------
# SQLite database and raw JSON archive (made private to the service user). Docker: /data.
#GROCERIES_DATA_DIR=./data
# Retailer logins (directory 700, files 600). Defaults to <data dir>/secrets. Keep it out of shared backups.
#GROCERIES_SECRETS_DIR=./data/secrets

# --- Web dashboard -----------------------------------------------------------------------------------
# Address to listen on. 127.0.0.1 = this machine only. Docker sets 0.0.0.0 inside the container;
# change the published port in compose.yaml instead.
#GROCERIES_HOST=127.0.0.1
#GROCERIES_PORT=8000
# Extra host names the dashboard answers to (comma-separated), besides localhost, IP addresses and
# GROCERIES_HOST. Protects against DNS rebinding. Add the name you open it by.
#GROCERIES_ALLOWED_HOSTS=groceries.example.com
# Behind a TLS-terminating reverse proxy: the proxy's IPs/CIDRs (comma-separated), so X-Forwarded-Proto
# is trusted. Without it, logins and buttons fail over https.
#GROCERIES_TRUSTED_PROXIES=192.0.2.10
# Access protection, off by default. Turn one on if anyone else can reach the dashboard.
# HTTP basic auth as user:password ...
#GROCERIES_BASIC_AUTH=me:a-long-random-password
# ... or require a header set by an authenticating reverse proxy. Needs GROCERIES_TRUSTED_PROXIES:
# the header is only accepted on connections from those addresses.
#GROCERIES_AUTH_PROXY_HEADER=Remote-User
# Chart library. Point it at a self-hosted copy to work fully offline.
#GROCERIES_ECHARTS_URL=https://cdn.jsdelivr.net/npm/echarts@5.5.1/dist/echarts.min.js

# --- Sync ----------------------------------------------------------------------------------------------
# Retailers that `groceries sync` handles (comma-separated: ah, jumbo). Empty: every connected one.
#GROCERIES_RETAILERS=
# Timezone used to put purchases on days and months (applies to purchases synced afterwards).
#GROCERIES_TZ=Europe/Amsterdam
# Seconds between API calls. Be polite.
#GROCERIES_REQUEST_DELAY=0.5
# User-Agent the Albert Heijn app API expects.
#GROCERIES_AH_USER_AGENT=Appie/8.22.3
# Refresh public shelf prices (open checkjebon dataset) after each sync, at most weekly.
# Needs git and about 150 MB of disk. Failures never fail the sync.
#GROCERIES_PUBLIC_PRICES=false
# Docker only: seconds between syncs in the sync container.
#GROCERIES_SYNC_INTERVAL=86400

# --- Notifications when a sync starts failing and when it works again (optional) ---------------------
# An ntfy topic URL, plus an access token if your ntfy server needs one.
#GROCERIES_NTFY_URL=https://ntfy.sh/your-random-topic
#GROCERIES_NTFY_TOKEN=
#GROCERIES_NTFY_PRIORITY=high
# Any URL that accepts a JSON POST {"title", "message", "priority", "tags"}.
#GROCERIES_WEBHOOK_URL=https://example.com/hooks/groceries
# Message titles. {retailer} is the retailer name, {reason} (failure title only) a short error.
#GROCERIES_ALERT_FAIL_TITLE=⚠ {retailer} sync failed
#GROCERIES_ALERT_RESOLVED_TITLE=✅ Resolved: {retailer} sync
