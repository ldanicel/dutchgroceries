[Unit]
Description=Groceries: sync purchase history
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=groceries
Group=groceries
Environment=GROCERIES_ENV_FILE=/opt/dutchgroceries/config.env
ExecStart=/opt/dutchgroceries/venv/bin/groceries sync
TimeoutStartSec=1h
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/opt/dutchgroceries/data /opt/dutchgroceries/secrets
